{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Домочатцы DATA-API 1.0 (формат команды, не схема организатора)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "solution", "base_url", "openapi_file", "test_data_file", "accounts_file", "variables", "authentication", "checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "solution": {"type": "object", "required": ["name", "team_id"], "properties": {"name": {"type": "string", "minLength": 1}, "team_id": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "base_url": {"type": "string", "format": "uri", "pattern": "^https://[^/]+$"},
    "openapi_file": {"const": "openapi.yaml"},
    "test_data_file": {"const": "test-data.json"},
    "accounts_file": {"const": "accounts.private.json"},
    "variables": {"type": "object", "required": ["origin"], "properties": {"origin": {"type": "string", "format": "uri"}}, "additionalProperties": false},
    "authentication": {"type": "object", "required": ["type", "name", "roles"], "properties": {"type": {"const": "cookie"}, "name": {"const": "max_session"}, "roles": {"type": "array", "items": {"enum": ["resident", "neighbor", "dispatcher"]}, "uniqueItems": true, "minItems": 3}}, "additionalProperties": false},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "required", "role", "operation_id", "request", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "description": {"type": "string", "minLength": 1},
        "required": {"const": true},
        "role": {"enum": ["anonymous", "resident", "neighbor", "dispatcher"]},
        "operation_id": {"type": "string", "minLength": 1},
        "request": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "path", "path_parameters", "query", "headers"],
          "properties": {
            "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
            "path": {"type": "string", "pattern": "^/[^?#]*$"},
            "path_parameters": {"type": "object"}, "query": {"type": "object"}, "headers": {"type": "object"},
            "body": {},
            "multipart": {"type": "object", "required": ["fields", "files"], "properties": {"fields": {}, "files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["field", "path", "content_type"], "properties": {"field": {"type": "string"}, "path": {"type": "string"}, "content_type": {"type": "string"}}, "additionalProperties": false}}}, "additionalProperties": false}
          },
          "not": {"required": ["body", "multipart"]}
        },
        "expected": {
          "type": "object", "additionalProperties": false, "required": ["status_codes"],
          "properties": {
            "status_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 100, "maximum": 599}},
            "content_type": {"type": "string"}, "schema": {"type": "object"},
            "required_fields": {"type": "array", "items": {"type": "string"}},
            "assertions": {"type": "array", "items": {"type": "object", "required": ["pointer"], "properties": {"pointer": {"type": "string"}, "equals": {}, "excludes_object": {"type": "object"}}, "additionalProperties": false, "oneOf": [{"required": ["equals"]}, {"required": ["excludes_object"]}]}}
          }
        },
        "extract": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^/"}}
      }
    }
  }
}
