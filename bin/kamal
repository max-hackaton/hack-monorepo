#!/usr/bin/env ruby
# frozen_string_literal: true

root = File.expand_path("..", __dir__)
Dir.chdir(root)
ENV["BUNDLE_GEMFILE"] = File.join(root, "backend/Gemfile")

require "rubygems"
require "bundler/setup"
require "dotenv"

Dotenv.load(File.join(root, ".env.deploy")) unless ENV["GITHUB_ACTIONS"] == "true"
load Gem.bin_path("kamal", "kamal")
